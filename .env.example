# ============================================
# Lastro — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
# ============================================

# Caminho para o state.db do Hermes Agent
LASTRO_STATE_DB=/opt/data/state.db

# Caminho para o vault Obsidian
LASTRO_VAULT_PATH=/opt/data/obsidian-vault

# Timezone (opcional — o Lastro detecta automaticamente)
# Formatos válidos: "America/Sao_Paulo", "America/New_York", "Europe/Lisbon"
# Deixe vazio para usar a detecção automática (5 níveis de fallback)
LASTRO_TIMEZONE=
